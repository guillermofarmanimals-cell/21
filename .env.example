# MJ APEX TRADER — Environment Variables
# Copy this to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: MetaTrader 5 credentials (leave blank to run in simulation mode)
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=

# Optional: Nasdaq Data Link key for live COT reports
QUANDL_API_KEY=
